class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
        left = right = null;
    }
}

public class KthSmallestBST {

    Node root;
    int count = 0;
    int answer = -1;

    void kth(Node root, int k) {

        if (root == null) return;

        kth(root.left, k);

        count++;

        if (count == k) {
            answer = root.data;
            return;
        }

        kth(root.right, k);
    }

    public static void main(String[] args) {

        KthSmallestBST tree = new KthSmallestBST();

        tree.root = new Node(5);
        tree.root.left = new Node(3);
        tree.root.right = new Node(7);
        tree.root.left.left = new Node(2);
        tree.root.left.right = new Node(4);
        tree.root.right.right = new Node(8);

        int k = 3;

        tree.kth(tree.root, k);

        System.out.println(tree.answer);
    }
}
