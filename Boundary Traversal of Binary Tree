class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
        left = right = null;
    }
}

public class BuildTree {

    static int index = 0;

    Node build(int preorder[], int inorder[], int start, int end) {

        if (start > end) return null;

        int val = preorder[index++];
        Node root = new Node(val);

        if (start == end) return root;

        int pos = start;

        while (inorder[pos] != val) {
            pos++;
        }

        root.left = build(preorder, inorder, start, pos - 1);
        root.right = build(preorder, inorder, pos + 1, end);

        return root;
    }

    void inorderPrint(Node root) {

        if (root == null) return;

        inorderPrint(root.left);
        System.out.print(root.data + " ");
        inorderPrint(root.right);
    }

    public static void main(String[] args) {

        BuildTree tree = new BuildTree();

        int preorder[] = {1,2,4,5,3};
        int inorder[] = {4,2,5,1,3};

        Node root = tree.build(preorder, inorder, 0, inorder.length - 1);

        tree.inorderPrint(root);
    }
}
